{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.financeospro.com"
        }
      ],
      "destination": "https://app.moyiq.app/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "demo.financeospro.com"
        }
      ],
      "destination": "https://demo.moyiq.app/$1",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://www.moyiq.app/",
      "permanent": true
    },
    {
      "source": "/signup",
      "destination": "/app/?open=signup",
      "permanent": true
    },
    {
      "source": "/upgrade",
      "destination": "/app/?open=upgrade",
      "permanent": true
    },
    {
      "source": "/import",
      "destination": "/app/?open=import",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "destination": "/app/?open=dashboard",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/app/((?!assets|favicon|icon|manifest|sw|workbox).*)",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
