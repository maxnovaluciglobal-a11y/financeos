# FinanceOS — variables de entorno
# Copia este archivo como .env y completa los valores con tu proyecto Supabase
# Crea tu proyecto en: https://supabase.com/dashboard → New Project

VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# Cloudflare Turnstile (SEG-1 / SEG-7, docs/turnstile.md). Clave PÚBLICA del widget moyiq-forms.
# Vacía = sin widget: formularios y login funcionan como antes. En local se puede usar la de
# prueba de Cloudflare 1x00000000000000000000AA (siempre pasa).
VITE_TURNSTILE_SITE_KEY=
